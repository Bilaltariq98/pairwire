                {
                  "type": "text",
                  "id": "zHF6r",
                  "name": "wnTitle1",
                  "fill": "$--font-primary",
                  "content": "Window Management",
                  "fontFamily": "Inter",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "YDLQS",
                  "name": "wn1",
                  "fill": "$--font-secondary",
                  "content": "▸ WS_EX_TOPMOST + WS_EX_TOOLWINDOW (no taskbar entry)",
                  "fontFamily": "monospace",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "IryJx",
                  "name": "wn2",
                  "fill": "$--font-secondary",
                  "content": "▸ WS_EX_NOACTIVATE to avoid stealing focus",
                  "fontFamily": "monospace",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "cRac0",
                  "name": "wn3",
                  "fill": "$--font-secondary",
                  "content": "▸ Docked to top of work area (respects taskbar position)",
                  "fontFamily": "Inter",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rIp1a",
                  "name": "wn4",
                  "fill": "$--font-secondary",
                  "content": "▸ cornerRadius: 2px (sharper than macOS, Win11-adjacent)",
                  "fontFamily": "Inter",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "SuCSD",
                  "name": "wn5",
                  "fill": "$--font-secondary",
                  "content": "▸ DWM Mica backdrop for native translucency on Win11",
                  "fontFamily": "Inter",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "hdItr",
                  "name": "wn6",
                  "fill": "$--font-secondary",
                  "content": "▸ Fallback to solid bg on Win10 (no Mica support)",
                  "fontFamily": "Inter",
                  "fontSize": 10,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "h4eWI",
                  "name": "wn7",
                  "fill": "$--font-secondary",
                  "content": "▸ System tray icon for quick access when bar is hidden",
                  "fontFamily": "Inter",
                  "fontSize": 10,
                  "fontWeight": "normal"
                }
